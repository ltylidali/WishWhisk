   "source": [
    "import os\n",
    "\n",
    "def notify_mac(title, text):\n",
    "    # 这行代码会调用 Mac 原生的系统通知\n",
    "    os.system(f\"\"\"osascript -e 'display notification \"{text}\" with title \"{title}\"'\"\"\")\n",
    "\n",
    "# 测试一下！\n",
    "notify_mac(\"Lemaire 降价啦！\", \"快看！一只野生的小号黑牛角跌破 $1000 CAD 了！\")"
   ]
